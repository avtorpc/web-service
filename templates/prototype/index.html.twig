{% extends 'base.html.twig' %}

{% block head %}
<meta name="registration-csrf" content="{{ registration_csrf }}">
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>место — работа, которая вам подходит</title>
<link rel="stylesheet" href="/css/styles.css?v=acdf33b0f218">
{% endblock %}

{% block body %}
<div class="wrap">
<header><a class="logo" href="./index.html" aria-label="место — главная"><span class="mark"></span>место</a><nav><a href="#vacancies" class="active" id="allNav">Вакансии</a><a href="#workers" id="workersNav">Работники</a></nav>{% include 'prototype/auth-navigation.html.twig' %}</header>
<main><section class="hero"><div class="eyebrow"><span class="dot"></span>Новый этап начинается здесь</div><h1>Найдите работу.<br><span>И своё место.</span></h1><p class="intro">Хорошая работа — та, что подходит именно вам.<br>Выбирайте команду, задачи и свой ритм.</p><div class="hero-art" aria-hidden="true"><div class="ring"></div><div class="ring second"></div></div>
<form class="search" id="searchForm"><label class="search-field"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input type="search" id="query" placeholder="Должность, компания или ключевое слово" aria-label="Поиск вакансий"></label><div class="search-field location"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2"/></svg><details class="city-picker" id="cityPicker"><summary id="citySummary">Любой город</summary><div class="city-menu"><p>Можно выбрать несколько городов</p><div id="cityOptions"></div><button type="button" class="reset" id="clearCities">Очистить выбор</button></div></details></div><button class="primary" type="submit">Найти работу <span aria-hidden="true">↗</span></button></form><div class="suggestions" id="popularSpecialties"><span>Самые востребованные:</span></div></section>
<section class="content" id="vacancies"><aside><a class="my-resume-card" id="createVacancy" href="/cabinet" hidden><span class="my-resume-label">Кабинет работодателя <span aria-hidden="true">↗</span></span><strong>Мои вакансии</strong><span>Создание и редактирование вакансий</span></a><a class="my-resume-card" id="myResume" href="user.html"><strong class="my-resume-label" id="myResumeTitle">Личный кабинет и резюме ↗</strong><span>Резюме, отклики и чаты с работодателями</span></a><div class="filter-title">Фильтры<button class="reset" id="reset">Сбросить</button></div><div class="group"><h3>Формат работы</h3><div id="formatOptions"><label class="check"><input type="checkbox" name="format" value="Удалённо">Удалённо</label><label class="check"><input type="checkbox" name="format" value="В офисе">В офисе</label><label class="check"><input type="checkbox" name="format" value="Гибрид">Гибрид</label></div></div><div class="group"><h3 id="salaryTitle">Ожидаемый доход</h3><input class="salary" type="number" min="0" step="10000" id="salary" placeholder="От, ₽ в месяц" aria-label="Минимальная зарплата"></div><div class="group"><h3>Опыт работы</h3><div id="experienceOptions"><label class="check"><input type="checkbox" name="experience" value="Без опыта">Без опыта</label><label class="check"><input type="checkbox" name="experience" value="1–3 года">От 1 года до 3 лет</label><label class="check"><input type="checkbox" name="experience" value="3–6 лет">От 3 до 6 лет</label><label class="check"><input type="checkbox" name="experience" value="Более 6 лет">Более 6 лет</label></div></div><section class="skills-filter" aria-labelledby="skillsTitle"><label class="specialty-label" for="specialty">Специальность</label><input id="specialty" class="specialty-select" type="text" list="specialtySuggestions" placeholder="Введите название вакансии" autocomplete="off"><datalist id="specialtySuggestions"></datalist><h3 id="skillsTitle">Востребованные навыки</h3><p id="skillsContext" class="skills-hint" aria-live="polite">Чаще всего встречаются в вакансиях</p><div id="skillsList" class="skills-list"></div><p class="skills-hint skills-help">Покажем вакансии хотя бы с одним выбранным навыком.</p></section><section class="skills-filter requirements-filter" aria-labelledby="requirementsTitle"><h3 id="requirementsTitle">Квалификация и качества</h3><p id="requirementsContext" class="skills-hint" aria-live="polite">Чаще всего встречаются в вакансиях</p><div id="requirementsList" class="skills-list"></div><p class="skills-hint skills-help">Покажем вакансии хотя бы с одним выбранным качеством или требованием.</p></section></aside><div><div class="results-head"><h2 id="resultsTitle">Вакансии, открытые сегодня <span id="total"></span></h2><select class="sort" id="sort" aria-label="Сортировка"><option value="new">Сначала новые</option><option value="salary">По уровню зарплаты</option></select></div><div class="day-navigation" id="dayNavigation" aria-label="Вакансии по дням"><div class="day-label" id="dayLabel" aria-live="polite"></div><div class="day-buttons"><button type="button" id="olderDay">← +1 день назад</button><button type="button" id="newerDay">На день вперёд →</button><button type="button" id="todayDay">Сегодня</button></div></div><button type="button" class="filters-button" id="showFilters" aria-haspopup="dialog">Выбранные фильтры <span id="filterCount">0</span></button><div id="chips" class="active-filters"></div><div id="jobs" aria-live="polite"></div><button class="load" id="load">Показать ещё вакансии ↓</button></div></section></main><footer class="footer"><span><b>место</b> · У каждого есть своё.</span><span>Вакансии работодателей</span></footer></div>
<dialog id="filtersModal" aria-labelledby="filtersModalTitle"><button type="button" class="close" id="closeFilters" aria-label="Закрыть выбранные фильтры">×</button><h2 id="filtersModalTitle">Выбранные фильтры</h2><div id="filtersContent"></div><section class="save-filter-panel"><h3>Ваш поиск — под рукой</h3><p>Зарегистрированные пользователи смогут сохранять фильтры в профиле. В прототипе доступно пробное сохранение в этом браузере.</p><div class="save-filter-actions"><button type="button" class="primary" id="saveFilters">Сохранить фильтры</button><button type="button" class="load" id="restoreFilters" hidden>Применить сохранённые</button></div><p id="filterSaveStatus" role="status" aria-live="polite"></p></section><div class="filter-actions"><button type="button" class="load" id="resetFilters">Сбросить все</button><button type="button" class="primary" id="doneFilters">Готово</button></div></dialog>
{% if not authenticated %}
<dialog id="authModal" aria-labelledby="authTitle">
<button type="button" class="close" id="closeAuth" aria-label="Закрыть окно входа">×</button>
<div class="eyebrow">Личный кабинет</div><h2 id="authTitle">Рады вас видеть</h2>
<div class="auth-tabs" role="tablist" aria-label="Вход или регистрация">
<button type="button" role="tab" id="loginTab" aria-controls="loginPanel" aria-selected="true">Войти</button>
<button type="button" role="tab" id="registerTab" aria-controls="registerPanel" aria-selected="false" tabindex="-1">Зарегистрироваться</button>
</div>
<div id="loginPanel" role="tabpanel" aria-labelledby="loginTab">
<form id="loginForm" class="auth-form">
<label for="loginEmail">Электронная почта *</label><input id="loginEmail" type="email" autocomplete="username" placeholder="name@example.com" required>
<label for="loginPassword">Пароль *</label><input id="loginPassword" type="password" autocomplete="current-password" placeholder="Введите пароль" required>
<button type="submit" class="primary">Войти</button>
</form></div>
<div id="registerPanel" role="tabpanel" aria-labelledby="registerTab" hidden>
<form id="registerForm" class="auth-form">
<label for="registerName">Ваше имя *</label><input id="registerName" type="text" autocomplete="name" placeholder="Как к вам обращаться" required maxlength="100">
<label for="registerRole">Я хочу *</label><select id="registerRole"><option value="applicant">Найти работу</option><option value="employer">Найти работников</option></select>
<div id="employerRegistrationFields" class="auth-form" hidden>
<label for="registerEmployerType">Тип работодателя *</label><select id="registerEmployerType"><option value="company">Компания</option><option value="entrepreneur">Индивидуальный предприниматель</option><option value="private">Частный работодатель</option></select>
<label for="registerCompany">Название компании / имя работодателя *</label><input id="registerCompany" type="text" maxlength="150" placeholder="Название для кандидатов">
<p class="auth-note">Работодатели также подтверждают email перед входом.</p>
</div><label for="registerEmail">Электронная почта *</label><input id="registerEmail" type="email" autocomplete="email" placeholder="name@example.com" required>
<label for="registerPassword">Пароль *</label><input id="registerPassword" type="password" autocomplete="new-password" placeholder="Не менее 8 символов" minlength="8" required>
<label class="check"><input id="registerTerms" type="checkbox" required>Согласен на обработку персональных данных</label><button type="submit" class="primary">Отправить код на почту</button>
</form></div>
<p class="auth-note">После подтверждения email откроется вход с вашим паролем.</p>
<section id="emailVerification" hidden aria-labelledby="verifyHeading"><h3 id="verifyHeading">Подтвердите почту</h3><p id="verifyEmail"></p><form id="verifyForm" class="auth-form"><label for="emailCode">Код из письма *</label><input id="emailCode" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required placeholder="6 цифр"><button type="submit" class="primary">Подтвердить email</button></form><div class="verification-actions"><button type="button" id="resendEmailCode">Отправить код повторно</button><button type="button" id="changeVerifyEmail">Указали неверный email? Начать заново</button></div><p id="verifyStatus" role="status"></p></section><p id="authStatus" class="auth-status" role="status" aria-live="polite"></p>
</dialog>
{% endif %}
<script id="vacancyCatalogData" type="application/json">{{ catalog_json|raw }}</script>
<script src="/js/user-store.js" defer></script><script src="/js/data.js" defer></script>
<script src="/js/assessment-store.js" defer></script><script src="/js/application.js" defer></script><script src="/js/main.js?v=645771528060" defer></script>
<script src="/js/auth.js?v=8a9e07bda20c" defer></script>
{% endblock %}
