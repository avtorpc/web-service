{% if authenticated %}
{% if app.request.attributes.get('_route') != 'cabinet' %}<a href="/cabinet" class="nav-btn" id="cabinetLink">Личный кабинет</a>{% endif %}
<form action="{{ path('logout') }}" method="post" id="logoutForm" data-session-expires-at="{{ auth_expires_at }}">
    <input type="hidden" name="_csrf_token" value="{{ registration_csrf }}">
    {% if auth_email %}<span class="auth-account-email">{{ auth_email }}</span>{% endif %}
    <button type="submit" class="nav-btn login-button" id="logoutButton">Выйти</button>
</form>
{% else %}
<button type="button" class="nav-btn login-button" id="openAuth" aria-haspopup="dialog">Войти</button>
{% endif %}
