<!DOCTYPE html>
<html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="registration-csrf" content="{{ registration_csrf }}"><title>Личный кабинет — место</title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/cabinet.css"></head>
<body><div class="wrap"><header><a class="logo" href="/" aria-label="место — главная"><span class="mark"></span>место</a><nav><a href="/">Главная</a><a href="/cabinet" class="active">Личный кабинет</a></nav>{% include 'prototype/auth-navigation.html.twig' %}</header>
<main class="cabinet-page">
{% if cabinet_error %}<section class="cabinet-card"><h1>Личный кабинет</h1><p role="alert">{{ cabinet_error }}</p><a href="/cabinet" class="primary">Попробовать снова</a></section>
{% else %}
{% set p = workspace.profile %}{% set applicant = workspace.role == 'applicant' %}
<div class="cabinet-heading"><div class="eyebrow">{{ applicant ? 'Личный кабинет соискателя' : 'Личный кабинет работодателя' }}</div><h1>{{ applicant ? p.display_name : p.public_name }}</h1><p>{{ p.contact_email }} · Email подтверждён</p></div>
<div class="cabinet-columns"><section class="cabinet-card"><h2>{{ applicant ? 'Мой профиль' : 'Профиль работодателя' }}</h2>
<form id="profileForm" class="cabinet-form" data-role="{{ workspace.role }}">
{% if applicant %}
<label>Имя<input name="display_name" value="{{ p.display_name }}" required maxlength="100" autocomplete="name"></label>
<label>Профессиональный заголовок<input name="headline" value="{{ p.headline }}" maxlength="150" placeholder="Например, PHP-разработчик"></label>
<label>О себе<textarea name="bio" rows="4" maxlength="5000">{{ p.bio }}</textarea></label>
<label>Видимость профиля<select name="visibility"><option value="private" {{ p.visibility == 'private' ? 'selected' : '' }}>Скрытый</option><option value="public" {{ p.visibility == 'public' ? 'selected' : '' }}>Публичный</option></select></label>
{% else %}
<label>Контактное лицо<input name="contact_name" value="{{ p.contact_name }}" required maxlength="100" autocomplete="name"></label>
<label>Тип работодателя<select name="employer_type"><option value="company" {{ p.employer_type == 'company' ? 'selected' : '' }}>Компания</option><option value="entrepreneur" {{ p.employer_type == 'entrepreneur' ? 'selected' : '' }}>Индивидуальный предприниматель</option><option value="private" {{ p.employer_type == 'private' ? 'selected' : '' }}>Частный работодатель</option></select></label>
<label>Публичное название<input name="public_name" value="{{ p.public_name }}" required maxlength="150"></label>
<label>О работодателе<textarea name="description" rows="4" maxlength="5000">{{ p.description }}</textarea></label>
<label>Сайт<input name="website" type="url" value="{{ p.website }}" maxlength="500" placeholder="https://example.ru"></label>
{% endif %}
<label>Город<input name="city" value="{{ p.city }}" maxlength="100" autocomplete="address-level2"></label>
<button class="primary" type="submit">Сохранить профиль</button><p id="profileStatus" role="status" aria-live="polite"></p></form></section>
<section class="cabinet-card"><h2>{{ applicant ? 'Мои документы' : 'Мои вакансии' }}</h2>
<div class="cabinet-counters">{% for key, count in workspace.counts %}<div><strong>{{ count }}</strong><span>{{ {'resumes':'Резюме','applications':'Отклики','tests':'Задачи','vacancies':'Вакансии','offers':'Предложения'}[key] }}</span></div>{% endfor %}</div>
<p>{{ applicant ? 'У вас пока нет резюме и откликов.' : 'У вас пока нет вакансий и откликов соискателей.' }}</p>
<p class="cabinet-note">Создание и публикация документов будут доступны на следующем этапе.</p>
{% if not applicant %}<h3>Квалификация соискателей</h3><p>Квалификационные задачи проходят соискатели. Работодателю проходить их не требуется.</p><p class="cabinet-note">Предварительные результаты тестирования не являются подтверждённым грейдом.</p>{% endif %}
</section></div>
{% if applicant %}<section class="cabinet-card" id="resumesSection"><div class="eyebrow">Профиль для поиска</div><h2>Мои резюме</h2><p>Создайте несколько версий резюме под разные специализации. Навыки и результаты тестирования сохраняются отдельно.</p><form id="resumeForm" class="cabinet-form"><label>Название резюме<input name="title" required maxlength="150" placeholder="Например, Backend-разработчик PHP"></label><div class="cabinet-columns"><label>Специализация<input name="specialty" maxlength="150"></label><label>Город<input name="city" maxlength="100"></label><label>Опыт<input name="experience" maxlength="100" placeholder="3–6 лет"></label><label>Желаемый доход<input name="salary" inputmode="numeric" maxlength="30"></label></div><label>О себе<textarea name="about" rows="3" maxlength="5000"></textarea></label><label>Навыки<input name="skills" maxlength="1000" placeholder="PHP, API, PostgreSQL"></label><p id="resumeStatus" role="status" aria-live="polite"></p><button class="primary" type="submit">Создать резюме</button></form><div id="resumeList" class="resume-list">{% for resume in workspace.resumes %}<article class="resume-card"><h3>{{ resume.title }}</h3><p>{{ resume.content.specialty|default('Специализация не указана') }} · {{ resume.content.city|default('Город не указан') }}</p><p>{{ resume.content.skills|default([])|join(' · ') }}</p><ul>{% for result in resume.skill_results %}<li>Навык №{{ result.competency_id }} — {{ result.label }}</li>{% endfor %}</ul></article>{% else %}<p class="cabinet-note">Резюме пока нет.</p>{% endfor %}</div></section>{% endif %}
{% if applicant %}<section class="cabinet-card assessment-section" id="assessmentSection"><div class="eyebrow">Профессиональные навыки</div><h2>Выбор следующего задания</h2><p>Выберите специализацию, предполагаемый грейд, от одной до трёх компетенций и технологии. Сохранённый выбор восстановится при возвращении в кабинет.</p><p class="cabinet-note">У вас один текущий выбор. Его изменение не меняет ранее полученные задания. Предполагаемый грейд не подтверждает квалификацию.</p>
{% if assessment_error %}<p role="alert">{{ assessment_error }}</p><a href="/cabinet">Обновить страницу</a>
{% else %}<form id="assessmentForm" class="cabinet-form"><div class="cabinet-columns">
<label>Специализация<select id="assessmentSpecialization" required><option value="">Выберите специализацию</option>{% for item in assessment.specializations %}<option value="{{ item.id }}" {{ preferences.specializationId|default(null) == item.id ? 'selected' : '' }}>{{ item.name }}</option>{% endfor %}</select></label>
<label>Предполагаемый грейд<select id="assessmentGrade" required><option value="">Выберите грейд</option>{% for item in assessment.grades %}<option value="{{ item.id }}" {{ preferences.gradeId|default(null) == item.id ? 'selected' : '' }}>{{ item.name }}</option>{% endfor %}</select></label></div>
<fieldset><legend>Компетенции — выберите 1–3</legend><div id="assessmentCompetencies" class="competency-grid"></div></fieldset>
<fieldset><legend>Технологии — при необходимости</legend><div class="technology-grid">{% for item in assessment.technologies %}<label class="cabinet-check"><input type="checkbox" name="technology" value="{{ item.id }}" {{ item.id in preferences.technologyIds|default([]) ? 'checked' : '' }}><span>{{ item.name }}</span></label>{% endfor %}</div></fieldset>
<div class="task-actions"><button type="submit">Сохранить выбор тестирования</button><button type="button" class="primary" id="getAssignment" {{ preferences ? '' : 'disabled' }}>Получить тестовое задание</button></div><p id="assessmentStatus" role="status" aria-live="polite"></p></form>{% endif %}
<section id="myTasks"><h3>Мои задания</h3>{% if workspace.tests %}<ul class="task-list">{% for task in workspace.tests %}<li><a href="/cabinet/tests/{{ task.id }}">{{ task.title|default('Задание №' ~ task.id, true) }}</a><span>{{ task.created_at|date('d.m.Y H:i') }} · {{ task.attempt_status ? {'in_progress':'Ответ в работе','evaluating':'Оценивается','preliminary':'Предварительная оценка','awaiting_review':'Есть неопределённые проверки','evaluation_failed':'Ошибка оценки','verified':'Оценка доступна'}[task.attempt_status] : {'generating':'Готовится','ready':'Задание готово','generation_failed':'Ошибка генерации'}[task.status] }}</span>{% if task.status == 'ready' %}<a class="primary task-open-button" href="/cabinet/tests/{{ task.id }}">Перейти к заданию</a>{% endif %}</li>{% endfor %}</ul>{% else %}<p>Заданий пока нет. Сохраните выбор и нажмите «Получить тестовое задание».</p>{% endif %}</section>
{% if workspace.tests_pages > 1 %}<nav aria-label="Страницы заданий">{% if workspace.tests_page > 1 %}<a href="/cabinet?testsPage={{ workspace.tests_page - 1 }}#myTasks">Предыдущие</a>{% endif %}<span>{{ workspace.tests_page }} из {{ workspace.tests_pages }}</span>{% if workspace.tests_page < workspace.tests_pages %}<a href="/cabinet?testsPage={{ workspace.tests_page + 1 }}#myTasks">Следующие</a>{% endif %}</nav>{% endif %}</section>{% endif %}
{% endif %}
</main><footer class="footer"><span>место · У каждого есть своё.</span></footer></div>
<script type="application/json" id="assessmentData">{{ assessment_json|raw }}</script><script src="/js/cabinet.js?v=resume-10" defer></script><script src="/js/auth.js" defer></script></body></html>
